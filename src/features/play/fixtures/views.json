        {
          "id": "roll",
          "source": "engine",
          "title": "Roll dice",
          "description": "Roll a dice expression for the table to see. A comparison straight after a dice group counts the dice that meet it (5d10>=7); compare a total in parentheses ((5d10)>6). d% is a d100. N# rolls N times; adv/dis keeps the better or worse of two.",
          "params": {
            "type": "object",
            "properties": {
              "expr": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              },
              "repeat": {
                "type": "integer",
                "minimum": 1,
                "maximum": 20
              },
              "mode": {
                "type": "string",
                "enum": ["adv", "dis"]
              }
            },
            "additionalProperties": false
          },
          "role": "player",
          "available": true,
          "text": {
            "forms": ["roll", "r"],
            "usage": ".r [N#][expr] [adv|dis] — e.g. .r 3d6+2, .r 2#1d20 adv, .r 5d10>=7"
          }
        },
        {
          "id": "sheet",
          "source": "engine",
          "title": "Character sheet",
