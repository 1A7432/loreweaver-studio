{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noFallthroughCasesInSwitch": true,
    "types": ["vite/client"],
    // Protocol 3.0's client library from source, TEMPORARILY a path dependency on the engine
    // checkout until loreweaver-protocol 3.0.0 is on npm (see vite.config.ts).
    "paths": {
      "loreweaver-protocol/v3": ["./node_modules/loreweaver-protocol/src/v3/index.ts"]
    }
  },
  "include": ["src", "vitest.setup.ts"]
}
